{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "src/**/*.json",
    "src/**/*.ts",
    "src/**/types/*",
    "tests/consumer/src/examples/HeaderExample.vue",
    "tests/consumer/src/examples/MainPanelExample.vue",
    "tests/consumer/src/examples/demo/**/*.vue",

  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "moduleResolution": "bundler",
    "composite": true,
    "paths": {
      "@/*": ["./src/*"],
      "rayyy-vue-table-components/components": ["./src/components/index.ts"],
      "tailwind.config.js": ["./tailwind.config.d.ts"]
    },
    "types": ["element-plus/global", "vitest/importMeta"]
  }
}
