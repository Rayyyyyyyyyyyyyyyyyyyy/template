{
  "name": "rayyy-vue-table-components",
  "version": "2.1.0",
  "description": "Vue 3 + Element Plus 表格組件庫",
  "type": "module",
  "main": "./dist/lib/index.cjs",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs"
    },
    "./tailwind-preset": {
      "types": "./tailwind-preset.d.cts",
      "import": "./tailwind-preset.cjs",
      "require": "./tailwind-preset.cjs"
    },
    "./types": {
      "types": "./dist/lib/src/types/index.d.ts",
      "import": "./dist/lib/types.js",
      "require": "./dist/lib/types.cjs"
    },
    "./components": {
      "types": "./dist/lib/src/components/index.d.ts",
      "import": "./dist/lib/components.js",
      "require": "./dist/lib/components.cjs"
    },
    "./types/components": {
      "types": "./dist/lib/src/types/components.d.ts"
    },
    "./utils": {
      "types": "./dist/lib/src/utils/tableHelper.d.ts",
      "import": "./dist/lib/utils.js",
      "require": "./dist/lib/utils.cjs"
    },
    "./utils/styles": {
      "types": "./dist/lib/src/utils/tableStyles.d.ts",
      "import": "./dist/lib/utils-styles.js",
      "require": "./dist/lib/utils-styles.cjs"
    },
    "./locales": {
      "types": "./dist/lib/src/locales/index.d.ts",
      "import": "./dist/lib/locales.js",
      "require": "./dist/lib/locales.cjs"
    },
    "./styles": "./dist/lib/rayyy-vue-table-components.css",
    "./styles/element": "./src/assets/styles/element/index.scss"
  },
  "sideEffects": ["**/*.css", "**/*.scss"],
  "files": [
    "dist/lib/**/*",
    "src/assets/styles/element/index.scss",
    "tailwind-preset.cjs",
    "tailwind-preset.d.cts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "vue",
    "vue3",
    "element-plus",
    "table",
    "components",
    "typescript",
    "tailwind"
  ],
  "author": "Ray Shao",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rayyyyyyyyyyyyyyyyyyyy/template.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-lib {@}\" --",
    "build-lib": "vite build --mode lib",
    "build-demo": "vite build",
    "build:netlify": "run-p type-check \"build-demo {@}\" --",
    "preview": "vite preview --host 127.0.0.1 --outDir dist/demo",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run --reporter=verbose",
    "prepare": "cypress install",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src/",
    "prepublishOnly": "npm run verify",
    "fetchI18n": "node ./scripts/fetch-i18n.js",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "check:package": "node scripts/check-package.mjs",
    "lint:fix": "eslint . --fix",
    "check:release-boundaries": "node scripts/check-release-boundaries.mjs",
    "verify": "run-s lint type-check test:unit:ci build-lib build-demo check:package test:e2e check:release-boundaries"
  },
  "peerDependencies": {
    "element-plus": "^2.9.3",
    "vue": "^3.3.0",
    "vue-i18n": ">=10.0.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tsconfig/node22": "^22.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vitest/eslint-plugin": "^1.1.36",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "@vueuse/core": "^11.2.0",
    "autoprefixer": "^10.4.21",
    "cypress": "^14.1.0",
    "element-plus": "^2.14.8",
    "eslint": "^9.21.0",
    "eslint-plugin-cypress": "^4.2.0",
    "eslint-plugin-vue": "~10.0.0",
    "jiti": "^2.4.2",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^7.0.2",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.0",
    "prettier": "3.5.3",
    "sass-embedded": "^1.86.0",
    "start-server-and-test": "^2.0.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.0",
    "unplugin-auto-import": "^19.1.1",
    "unplugin-vue-components": "^28.4.1",
    "vite": "^6.2.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.18",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.8",
    "vuedraggable": "^4.1.0"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
